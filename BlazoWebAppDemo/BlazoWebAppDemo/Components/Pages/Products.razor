@page "/products"
@using BlazoWebAppDemo.Data
@inject AppDbContext Db
@using Microsoft.EntityFrameworkCore

<h3>Products</h3>

<div class="mb-3">
    <a class="btn btn-primary" href="/product-create">Create Product</a>
</div>

@if (products == null)
{
    <p><em>Loading products...</em></p>
}
else if (!products.Any())
{
    <div class="alert alert-info">
        No products found. Click <strong>Create Product</strong> to add your first item.
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th class="text-end">Price</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in products)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.Description</td>
                    <td class="text-end">@product.Price.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Product>? products;

    protected override async Task OnInitializedAsync()
    {
        products = await Db.Products
            .OrderBy(p => p.Name)
            .ToListAsync();
    }
}